# M1 - WASD gaming layout (MirrorBoard layer 1)
#
#   TAB  Q  W  E  R  T  BKSP
#   SHFT A  S  D  F  G  ENTER
#        Z  X  C  V  B
#           CTRL ALT SPACE
#   Thumb LEFT: -> M3 (numbers)   Thumb DOWN: -> M2 (mirror)
profile m1
rgb 0 80 255
mod 1
load common.bind

bind G1 KEY_TAB
bind G2 KEY_Q
bind G3 KEY_W
bind G4 KEY_E
bind G5 KEY_R
bind G6 KEY_T
bind G7 KEY_BACKSPACE
bind G8 KEY_LEFTSHIFT
bind G9 KEY_A
bind G10 KEY_S
bind G11 KEY_D
bind G12 KEY_F
bind G13 KEY_G
bind G14 KEY_ENTER
bind G15 KEY_Z
bind G16 KEY_X
bind G17 KEY_C
bind G18 KEY_V
bind G19 KEY_B
bind G20 KEY_LEFTCTRL
bind G21 KEY_LEFTALT
bind G22 KEY_SPACE
bind LEFT !load m3.bind
bind DOWN !load m2.bind

clear
textmode 1
font 8x8
pos 0 0
out  M1  WASD          
textmode 0
font 5x8
pos 1 0
out Tab Q W E R T Bksp
pos 2 0
out Shf A S D F G Enter
pos 3 0
out  Z X C V B  Ctl Alt Spc
pos 4 0
out [M1]WASD M2 Mirr M3 Num
